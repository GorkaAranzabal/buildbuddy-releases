{
  "name": "gorka-copilot-overlay",
  "productName": "BuildBuddy",
  "version": "1.0.35",
  "description": "Desktop overlay assistant for Unreal Engine developers",
  "main": "dist/main/index.js",
  "author": "Gorka Copilot Team",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:electron": "vite build && unset ELECTRON_RUN_AS_NODE && electron .",
    "build": "vite build",
    "build:renderer": "vite build",
    "preview": "vite preview",
    "package": "vite build && electron-builder",
    "package:mac": "vite build && electron-builder --mac --dir",
    "package:win": "vite build && electron-builder --win",
    "publish": "export $(grep -v '^#' .env.local | xargs) && vite build && electron-builder --mac --win --publish always",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.37.0",
    "@jitsi/robotjs": "^0.6.21",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@runreal/unreal-mcp": "^0.1.4",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.7.3",
    "gopeak": "^2.3.3",
    "lowdb": "^7.0.1",
    "openai": "^4.28.0",
    "posthog-node": "^5.24.17",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.1",
    "reactflow": "^11.11.4",
    "unreal-remote-execution": "^1.0.0",
    "uuid": "^9.0.1",
    "ws": "^8.16.0",
    "youtube-transcript": "^1.3.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@types/node": "^20.11.19",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser": "^7.0.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "vite-plugin-electron": "^0.28.4",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "build": {
    "appId": "com.gorka.buildbuddy",
    "productName": "BuildBuddy",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": {
        "teamId": "998D48RKV7"
      },
      "extendInfo": {
        "NSAppleEventsUsageDescription": "BuildBuddy needs permission to control your computer to perform automated actions.",
        "NSAccessibilityUsageDescription": "BuildBuddy needs accessibility access to control mouse and keyboard for the 'Do it for me' feature.",
        "NSLocalNetworkUsageDescription": "BuildBuddy needs local network access to communicate with Unreal Engine via Remote Execution.",
        "NSBonjourServices": [
          "_ue4-py-remote._tcp"
        ]
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signingHashAlgorithms": [
        "sha256"
      ],
      "signDlls": true
    },
    "publish": {
      "provider": "github",
      "owner": "GorkaAranzabal",
      "repo": "buildbuddy-releases",
      "releaseType": "release"
    },
    "asarUnpack": [
      "node_modules/**",
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "node_modules/@jitsi/robotjs",
        "to": "node_modules/@jitsi/robotjs"
      },
      {
        "from": "build/icon.png",
        "to": "tray-icon.png"
      },
      {
        "from": "node_modules/gopeak/build/addon",
        "to": "godot-addon"
      }
    ]
  },
  "type": "module"
}
